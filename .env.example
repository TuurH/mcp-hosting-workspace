# Copy to .env (scripts/setup.ps1 does this and generates the random secrets).
# Never commit .env. Keep a copy in a password manager: backups of encrypted
# platform data cannot be restored without it.

# Optional image override. Use the matching devel image if you need nvcc/CUDA extension builds.
CUDA_BASE_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# Set this to a domain you control. Compose derives the MCP, files, admin,
# visitor login, and application hostnames from this domain.
PLATFORM_DOMAIN=example.com
MCP_SERVER_NAME=MCP Hosting Workspace

# Optional overrides for a custom MCP or files hostname. When overriding MCP,
# set both values to the same hostname and keep /mcp out of PUBLIC_MCP_URL.
# PUBLIC_MCP_URL=https://mcp.example.com
# PUBLIC_MCP_HOST=mcp.example.com
# PUBLIC_FILES_URL=https://files.example.com

# Origins allowed to call the MCP endpoint. The default covers ChatGPT and
# Claude; uncomment only to change it.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,https://claude.ai/,https://claude.com

# Paste the token printed by the Cloudflare Tunnel Docker setup page.
# Only the cloudflared container receives it.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access for mcp.example.com. The MCP endpoint stays LOCKED (503)
# until all four values are set: it never runs without authentication.
CF_ACCESS_ENABLED=true
CF_ACCESS_TEAM_DOMAIN=https://CHANGE-ME.cloudflareaccess.com
CF_ACCESS_AUD=CHANGE-ME
CF_ACCESS_ALLOWED_EMAILS=your-email@example.com

# Shared secret between the workspace and the files container (download links).
# scripts/setup.ps1 generates it; any random string of 32+ characters works.
FILES_MINT_TOKEN=

# ---------------------------------------------------------------- app platform
# The owner: logs in to admin.example.com and can open every app. setup.ps1
# fills in the first address of CF_ACCESS_ALLOWED_EMAILS when this is empty.
PLATFORM_OWNER_EMAIL=

# Application Audience (AUD) tag of the Cloudflare Access application for
# admin.example.com. The admin page stays locked (503) until it is set.
ADMIN_CF_ACCESS_AUD=

# Google OAuth client for the visitor login at auth.example.com. Until both are
# set, signing in to Only you and Shared apps fails (Public apps work without login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generated by scripts/setup.ps1. Never change DEPLOYER_SECRETS_KEY once app credentials
# or workspace tokens are stored: they can only be decrypted with it.
DEPLOYER_API_TOKEN=
DEPLOYER_SECRETS_KEY=
ADMIN_CSRF_KEY=
POMERIUM_SHARED_SECRET=
POMERIUM_COOKIE_SECRET=
POMERIUM_SIGNING_KEY=

# Group that owns /var/run/docker.sock inside containers (0 on Docker Desktop).
# test-local.ps1 reports when the deployer cannot use the socket.
DOCKER_SOCKET_GID=0

# Extra subdomains apps may never use, comma separated (your own DNS records,
# for example nas,router). mcp, files, admin, auth, www, minecraft and mail
# are always reserved.
RESERVED_APP_NAMES=

# Resource limits. Keep WORKSPACE_MEMORY_LIMIT below the memory= value in
# %UserProfile%\.wslconfig (see docs/wslconfig.example).
WORKSPACE_CPU_LIMIT=8
WORKSPACE_MEMORY_LIMIT=12g
WORKSPACE_SHM_SIZE=4gb
WORKSPACE_PIDS_LIMIT=2048

# Owner file-manager per-file upload ceiling (GiB); recreate admin after changing.
ADMIN_MAX_UPLOAD_GB=50

# MCP/runtime limits
DEFAULT_SYNC_TIMEOUT_SECONDS=180
MAX_SYNC_TIMEOUT_SECONDS=1800
MAX_TOOL_OUTPUT_CHARS=120000
MAX_COMMAND_LOG_BYTES=52428800
MAX_JOB_LOG_BYTES=262144000
MAX_IMPORT_BYTES=2147483648
MAX_WRITE_FILE_BYTES=10485760
MAX_DOWNLOAD_TTL_SECONDS=86400
MAX_PARALLEL_COMMANDS=4

# Backups (scripts/backup.ps1). Leave BACKUP_DIR empty to pick a folder the
# first time; the script remembers your choice here.
BACKUP_DIR=
BACKUP_WORKSPACE_FOLDERS=apps,projects
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
