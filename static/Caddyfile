# Serves every static app from /srv/sites/<host>/current. Only Pomerium and
# the deployer can reach this server (internal "platform" network). The site
# folders are written by the deployer; this container mounts them read-only.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Requests arrive through cloudflared and Pomerium; the visitor's
		# address is in Cf-Connecting-IP.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
	log access {
		output file /logs/access.log {
			# Readable by the deployer, which shows the logs on the admin page.
			mode 0644
			roll_size 10MiB
			roll_keep 5
		}
		format json
		include http.log.access
	}
}

:8080 {
	log
	root * /srv/sites/{http.request.host}/current
	header {
		# Lets the deployer's probe tell the static server from Pomerium's own pages.
		X-Hertogs-Static "1"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	file_server {
		hide .*
	}
	handle_errors {
		header X-Hertogs-Static "1"
		header -Server
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
